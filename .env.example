# Ollama Local Endpoint Configuration
OLLAMA_URL=http://localhost:11434

# RunPod GPU Budget Guardrail (USD)
MAX_RUNPOD_BUDGET_USD=10.00

# Directory for Persistent Storage, DB, and Cache
PROJECT_STATE_DIR=Project_State

# SHA-256 Hash Cache Time-To-Live (Seconds)
DEFAULT_CACHE_TTL_SEC=86400

# Default DAG Node Timeout (Seconds)
DEFAULT_DAG_NODE_TIMEOUT=60.0

# ─────────────────────────────────────────────────────────────
# Higgsfield AI — MCP Provider (DM AI OS Native Integration)
# Proyecto: Valeria Montesano Digital
# ─────────────────────────────────────────────────────────────

# Autenticación (obtener con: higgsfield auth token)
# Prioridad: HIGGSFIELD_AUTH_TOKEN > HIGGSFIELD_TOKEN > HIGGSFIELD_API_KEY
HIGGSFIELD_AUTH_TOKEN=your_higgsfield_auth_token_here
# HIGGSFIELD_TOKEN=your_higgsfield_token_here       # Alternativo
# HIGGSFIELD_API_KEY=your_higgsfield_api_key_here   # Alternativo

# URL del MCP server (default oficial — no cambiar salvo instrucción de Higgsfield)
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# Workspace y Personaje activo
HIGGSFIELD_WORKSPACE_ID=your_workspace_id_here
HIGGSFIELD_CHARACTER_ID=your_character_id_here       # ID de Valeria / Mi Influencer

# Modelos por defecto (proyecto Valeria Montesano Digital)
HIGGSFIELD_DEFAULT_IMAGE_MODEL=soul_2                # Soul 2 para imágenes con personaje
HIGGSFIELD_DEFAULT_VIDEO_MODEL=seedance_2_0          # Seedance 2.0 para videos
HIGGSFIELD_DEFAULT_ASPECT_RATIO=9:16                 # Vertical para redes sociales

# Proyecto y personaje activo
HIGGSFIELD_PROJECT_NAME=Valeria Montesano Digital
HIGGSFIELD_CHARACTER_NAME=Mi Influencer

# Estado del proveedor (enabled | disabled)
HIGGSFIELD_PROVIDER=enabled

# Parámetros de retry y polling
HIGGSFIELD_MAX_RETRIES=3
HIGGSFIELD_POLL_INTERVAL=5.0
HIGGSFIELD_MAX_POLL_TIME=300.0

# ─────────────────────────────────────────────────────────────
# NVIDIA NIM — FLUX.2 Klein 4B Provider
# ─────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
NVIDIA_DEFAULT_TIMEOUT=60.0

# ─────────────────────────────────────────────────────────────
# RunPod GPU Infrastructure — FLUX.2 & Video AI Provider
# ─────────────────────────────────────────────────────────────

# Authentication (REQUIRED — never commit real key)
RUNPOD_API_KEY=your_runpod_api_key_here

# Resource Identifiers (leave blank for dynamic creation)
RUNPOD_POD_ID=
RUNPOD_ENDPOINT_ID=
RUNPOD_TEMPLATE_ID=cw3nka7d08
RUNPOD_NETWORK_VOLUME_ID=tbupq29n08
RUNPOD_VOLUME_ID=

# Safety Guardrail — Require explicit authorization before spinning GPU to download models
MODEL_DOWNLOAD_REQUIRES_EXPLICIT_AUTHORIZATION=true


# GPU Selection (used when creating pod dynamically)
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090

# Disk Sizing
RUNPOD_VOLUME_GB=20
RUNPOD_CONTAINER_DISK_GB=20

# Lifecycle Control
RUNPOD_AUTO_START=true
RUNPOD_AUTO_STOP=true
RUNPOD_AUTO_TERMINATE=true
RUNPOD_IDLE_TIMEOUT_SECONDS=120
RUNPOD_MAX_RUNTIME_MINUTES=30
RUNPOD_REQUEST_TIMEOUT_SECONDS=900

# Model Selection
RUNPOD_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
RUNPOD_VIDEO_MODEL=wan2.2-i2v

# Endpoints
RUNPOD_COMFYUI_URL=http://127.0.0.1:8188
RUNPOD_API_URL=https://api.runpod.io/graphql

# HuggingFace token (optional — needed to download gated models)
HUGGINGFACE_TOKEN=

# ─────────────────────────────────────────────────────────────
# Creative Engine / Comfy MCP Configuration
# ─────────────────────────────────────────────────────────────
COMFY_PREFERRED_BACKEND=cloud               # cloud | runpod | local
COMFY_API_KEY=                               # Comfy Cloud API Key (comfyui-...)
COMFY_CLOUD_MCP_URL=https://cloud.comfy.org/mcp
COMFYUI_REMOTE_URL=                          # Remote RunPod ComfyUI endpoint
COMFYUI_LOCAL_ENABLED=false                  # Local backend disabled by default
COMFYUI_LOCAL_URL=http://127.0.0.1:8188      # Local ComfyUI (never exposed to Cloudflare)

