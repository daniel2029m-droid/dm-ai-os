# Ollama Local Endpoint Configuration
OLLAMA_URL=http://localhost:11434

# RunPod GPU Budget Guardrail (USD)
MAX_RUNPOD_BUDGET_USD=10.00

# Directory for Persistent Storage, DB, and Cache
PROJECT_STATE_DIR=Project_State

# SHA-256 Hash Cache Time-To-Live (Seconds)
DEFAULT_CACHE_TTL_SEC=86400

# Default DAG Node Timeout (Seconds)
DEFAULT_DAG_NODE_TIMEOUT=60.0
