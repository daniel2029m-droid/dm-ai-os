{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Wan 2.2 I2V Diffusion Model" },
    "inputs": {
      "unet_name": "wan2.2_i2v_480p_14B_fp8_scaled.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load UMT5-XXL Text Encoder" },
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load Wan VAE" },
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "_meta": { "title": "Load Reference Image" },
    "inputs": {
      "image": "REF_IMAGE_PLACEHOLDER"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": {
      "clip": ["2", 0],
      "text": "PROMPT_PLACEHOLDER"
    }
  },
  "6": {
    "class_type": "WanImageToVideo",
    "_meta": { "title": "Wan I2V Sampler" },
    "inputs": {
      "model": ["1", 0],
      "positive": ["5", 0],
      "vae": ["3", 0],
      "image": ["4", 0],
      "width": 832,
      "height": 480,
      "length": 81,
      "steps": 25,
      "cfg": 5.0,
      "seed": 42
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode Latent to Video Frames" },
    "inputs": {
      "samples": ["6", 0],
      "vae": ["3", 0]
    }
  },
  "8": {
    "class_type": "SaveAnimatedWEBP",
    "_meta": { "title": "Save Video Output" },
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "Wan22_I2V_RunPod",
      "fps": 16,
      "lossless": false,
      "quality": 85,
      "method": "default"
    }
  }
}
