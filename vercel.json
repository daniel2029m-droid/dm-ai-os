{
  "version": 2,
  "builds": [
    {
      "src": "src/api/server.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "src/api/server.py"
    },
    {
      "src": "/panel/(.*)",
      "dest": "src/api/server.py"
    },
    {
      "src": "/owner/(.*)",
      "dest": "src/api/server.py"
    },
    {
      "src": "/checkout",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
